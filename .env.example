# Database PostgreSQL (Neon o Supabase)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:port/database?sslmode=require"

# Segreto per firmare i cookie di sessione (OBBLIGATORIO in produzione, minimo 32 caratteri).
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="your-generated-secret-at-least-32-characters"
